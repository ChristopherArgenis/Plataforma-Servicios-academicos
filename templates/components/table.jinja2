{% macro prueba() %}
    <h6>Hola Estoy aqui</h6>
{% endmacro %}

{% macro select_year(years) %}
    <select class="form-select w-auto" name="year" aria-label="Default select example">
        <option selected disabled>Todos</option>
        {% for year in years %}
            <option value={{ year }}>{{year}}</option>
        {% endfor %}
    </select>
{% endmacro %}

{% macro search(years) %}
    <nav class="navbar bg-body-tertiary">
        <div class="container-fluid">
            <form method="POST" class="d-flex" role="search">
                {{ select_year(years) }}
                <input class="form-control me-2" type="search" placeholder="Título" aria-label="Search" name="titulo">
                <button class="btn btn-outline-success" type="submit">Buscar</button>
            </form>
        </div>
        <form method="GET" action={{ url_for('panel.panel_get') }}>
            <button class="btn btn-outline-primary" type="submit">Reiniciar</button>
        </form>
        <div class="p-2"></div>
        <form method="PUT" action={{ url_for('panel.panel_get') }}>
            <button class="btn btn-outline-dark" type="submit">Actualizar</button>
        </form>
        <div class="p-2"></div>
    </nav>
{% endmacro %}

{% macro columns_Articles() %}
    <tr>
        <th scope="col">T&iacutetulo</th>
        <th scope="col">A&ntildeo</th>
        <th scope="col">☑</th>
    </tr>
{% endmacro %}

{% macro table_articles(df, id_articles) %}
    <form action="{{ url_for('panel.get_articles') }}" method="POST">
        <table class="table table-striped table-hover">
            <thead class="table-light">
                {{ columns_Articles() }}
                <tbody>
                    {% for row in df.itertuples(index=False) %}
                        <tr>
                            {% for value in row %}
                                <td>{{ value }}</td>
                            {% endfor %}
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="keys[]" value="{{ id_articles[loop.index0][0] }}" id="checkDefault">
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </thead>
        </table>
        <div class="d-flex justify-content-end mb-3">
            <button type="submit" class="btn btn-outline-danger">Adquirir</button>
            <ul></ul>
        </div>
    </form>
{% endmacro %}