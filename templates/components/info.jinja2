{% macro selectForm() %}
    {# Contenedor principal con estilo de tarjeta #}
    <div id="card-selection-screen" class="card shadow-sm border-0 rounded-3 container mt-4 mb-4 p-4" style="max-width: 900px;">
        <h1 class="text-center mb-5">Registros</h1>
        <div class="row justify-content-center">
            {{ card_Docencia() }}
            {{ card_Promocion() }}
            {{ card_Intercambio() }}
            {{ card_Proyectos() }}
            {{ card_Participacion() }}
            {{ card_Actividades() }}
            {{ card_Otros() }}
        </div>
    </div>
{% endmacro %}