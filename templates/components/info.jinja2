{% macro card_Docencia() %}
    <div class="col-md-6 col-lg-4 mb-4">
        <div class="card h-100 shadow-sm border-dark">
            <div class="card-body text-center d-flex flex-column">
            <h5 class="card-title fs-4 mb-3 text-dark">Docencia</h5>
                <p class="card-text text-muted mb-4">Aquello relacionado con temas de Docencia.</p>
                <form action="{{ url_for('panel.admin_read') }}" method="GET">
                    <input type="hidden" name="table" value="Docencia">
                    {# Botón para ver datos #}
                    <button type="submit" class="btn btn-dark mt-auto rounded-pill">Ver Datos</button>
                </form>
            </div>
        </div>
    </div>
{% endmacro %}

