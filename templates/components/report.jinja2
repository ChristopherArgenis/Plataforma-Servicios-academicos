{% macro contentInfoGeneral(client, user_info, academic_info) %}
    <div class="card shadow-sm border-0 rounded-3 mb-4">
        <div class="card-body p-4">
            <h5 class="text-primary fw-bold mb-4"><i class="bi bi-person-lines-fill me-2"></i> Detalles del Investigador</h5>
            <div class="row g-4">
                {# Columna 1 #}
                <div class="col-md-6">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-light rounded-circle p-3 text-primary me-3">
                            <i class="bi bi-person fs-4"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.75rem;">Nombre</small>
                            <span class="fw-medium">{{ client.nombre if client else 'N/A' }}</span>
                        </div>
                    </div>
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-light rounded-circle p-3 text-primary me-3">
                            <i class="bi bi-envelope fs-4"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.75rem;">Correo</small>
                            <span class="fw-medium">{{ client.email if client else 'N/A' }}</span>
                        </div>
                    </div>
                </div>
                {# Columna 2 #}
                <div class="col-md-6">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-light rounded-circle p-3 text-primary me-3">
                            <i class="bi bi-building fs-4"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.75rem;">Afiliación</small>
                            <span class="fw-medium">{{ user_info.affilition if user_info and user_info.affilition else 'N/A' }}</span>
                        </div>
                    </div>
                    </div>
                </div>
                </div>
            </div>

            {% if academic_info %}
            <hr class="my-4 text-muted opacity-25">
            <h6 class="text-secondary fw-bold mb-3">Información Académica</h6>
            <div class="row g-3">
                <div class="col-md-3 col-6">
                    <div class="p-3 bg-light rounded-3 text-center h-100">
                        <small class="text-muted d-block mb-1">SNI</small>
                        <span class="fw-bold text-dark">{{ academic_info.sni if academic_info.sni else '-' }}</span>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="p-3 bg-light rounded-3 text-center h-100">
                        <small class="text-muted d-block mb-1">PRIDE</small>
                        <span class="fw-bold text-dark">{{ academic_info.pride if academic_info.pride else '-' }}</span>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="p-3 bg-light rounded-3 text-center h-100">
                        <small class="text-muted d-block mb-1">Departamento</small>
                        <span class="fw-bold text-dark">{{ academic_info.departamento if academic_info.departamento else '-' }}</span>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="p-3 bg-light rounded-3 text-center h-100">
                        <small class="text-muted d-block mb-1">Categoría</small>
                        <span class="fw-bold text-dark">{{ academic_info.categoria if academic_info.categoria else '-' }}</span>
                    </div>
                </div>
            </div>
            {% endif %}
        </div>
    </div>
{% endmacro %}

{% macro accordion(client, user_info, academic_info) %}
    <div class="container mt-4">
        <div class="accordion shadow-sm rounded" id="miAcordeon1">
            <div class="accordion-item border-0 rounded overflow-hidden">
                <h2 class="accordion-header" id="headingGeneral1">
                <button class="accordion-button fw-bold text-primary bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapseGeneral1" aria-expanded="true" aria-controls="collapseGeneral1">
                    <i class="bi bi-person-lines-fill me-2"></i> Información General
                </button>
                </h2>
                <div id="collapseGeneral1" class="accordion-collapse collapse show" aria-labelledby="headingGeneral1" data-bs-parent="#miAcordeon1">
                    <div class="accordion-body bg-white">
                        {{ contentInfoGeneral(client, user_info, academic_info) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endmacro %}

{% macro modal_pdf() %}
    <!-- Botón para abrir modal PDF -->
     <div class="d-flex justify-content-center my-5">
        <button type="button" class="btn btn-primary btn-lg shadow" data-bs-toggle="modal" data-bs-target="#pdfModal">
            <i class="bi bi-file-earmark-pdf me-2"></i> Ver reporte
        </button>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="pdfModal" tabindex="-1" aria-labelledby="pdfModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
          <div class="modal-header bg-primary text-white">
            <h5 class="modal-title" id="pdfModalLabel">
                <i class="bi bi-file-earmark-text me-2"></i> Reporte generado
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
          </div>
          <div class="modal-body p-0 bg-light">
            <div class="p-2 d-flex justify-content-end bg-white border-bottom">
                <a href="{{ url_for('static', filename='docs/ejemplo.pdf') }}" target="_blank" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-box-arrow-up-right me-1"></i> Abrir en nueva pestaña
                </a>
            </div>
            <iframe src="{{ url_for('static', filename='docs/ejemplo.pdf') }}" width="100%" height="600px" style="border: none"></iframe>
          </div>
        </div>
      </div>
    </div>
{% endmacro %}

{% macro simple_step_card(title, placeholder, icon_class, form_id) %}
    <div class="card shadow border-0 rounded-3 mb-4">
        <div class="card-header bg-white border-0 pt-4 px-4">
            <h4 class="text-primary fw-bold"><i class="bi {{ icon_class }} me-2"></i> {{ title }}</h4>
        </div>
        <div class="card-body p-4">
             <form id="{{ form_id }}">
                 <div class="form-floating mb-3">
                    <textarea class="form-control" name="descripcion" placeholder="{{ placeholder }}" style="height: 200px"></textarea>
                    <label>{{ placeholder }}</label>
                </div>
                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-success text-white shadow-sm">
                        <i class="bi bi-save me-2"></i> Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
{% endmacro %}

{% macro steps_report() %}
<!-- Barra de pasos -->
<!-- Barra de pasos - Fila Superior -->
  <div class="step-bar mb-5 mx-auto" style="max-width: 1000px;">
    <div class="progress-line" id="progress-line-1">
      <div id="progress-fill-1" class="progress-line-fill"></div>
    </div>
    <div class="d-flex justify-content-between w-100 position-relative">
        <div class="step active" id="step-1">
            <div class="circle shadow-sm"><i class="bi bi-pencil-square"></i></div>
            <div class="label fw-bold">Libros</div>
        </div>
        <div class="step" id="step-2">
            <div class="circle shadow-sm"><i class="bi bi-journal-text"></i></div>
            <div class="label fw-bold">Artículos</div>
        </div>
        <div class="step" id="step-3">
            <div class="circle shadow-sm"><i class="bi bi-book"></i></div>
            <div class="label fw-bold">Cursos</div>
        </div>
        <div class="step" id="step-4">
            <div class="circle shadow-sm"><i class="bi bi-people-fill"></i></div>
            <div class="label fw-bold">Comités</div>
        </div>
        <div class="step" id="step-5">
            <div class="circle shadow-sm"><i class="bi bi-megaphone"></i></div>
            <div class="label fw-bold">Difusión</div>
        </div>
        <div class="step" id="step-6">
            <div class="circle shadow-sm"><i class="bi bi-broadcast"></i></div>
            <div class="label fw-bold">Divulgación</div>
        </div>
        <div class="step" id="step-7">
            <div class="circle shadow-sm"><i class="bi bi-lightbulb"></i></div>
            <div class="label fw-bold">Patente</div>
        </div>
    </div>
  </div>

  <!-- Barra de pasos - Fila Inferior -->
  <div class="step-bar mb-5 mx-auto" style="max-width: 1000px;">
    <div class="progress-line" id="progress-line-2">
      <div id="progress-fill-2" class="progress-line-fill"></div>
    </div>
    <div class="d-flex justify-content-between w-100 position-relative">
        <div class="step" id="step-8">
            <div class="circle shadow-sm"><i class="bi bi-geo-alt"></i></div>
            <div class="label fw-bold">Estancias</div>
        </div>
        <div class="step" id="step-9">
            <div class="circle shadow-sm"><i class="bi bi-cash-coin"></i></div>
            <div class="label fw-bold">Financiados</div>
        </div>
        <div class="step" id="step-10">
            <div class="circle shadow-sm"><i class="bi bi-clipboard-check"></i></div>
            <div class="label fw-bold">Comisiones</div>
        </div>
        <div class="step" id="step-11">
            <div class="circle shadow-sm"><i class="bi bi-link-45deg"></i></div>
            <div class="label fw-bold">Vinculación</div>
        </div>
        <div class="step" id="step-12">
            <div class="circle shadow-sm"><i class="bi bi-award"></i></div>
            <div class="label fw-bold">Distinciones</div>
        </div>
        <div class="step" id="step-13">
            <div class="circle shadow-sm"><i class="bi bi-trophy"></i></div>
            <div class="label fw-bold">Logros</div>
        </div>
        <div class="step" id="step-14">
            <div class="circle shadow-sm"><i class="bi bi-check-lg"></i></div>
            <div class="label fw-bold">Finalizar</div>
        </div>
    </div>
  </div>
{% endmacro %}

