{% macro body_Tesis_Teaching() %}
    <div>
        <div class="p-4 bg-white">
            <form id="formularioGeneral3">
                
                <div class="mb-5 flex items-center">
                    <label for="estudiante3" class="block text-sm font-medium text-gray-700 w-1/3 mr-4">Estudiante: </label>
                    <input type="text" id="estudiante3" placeholder="Nombre del estudiante..." class="input-field px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition duration-300">
                </div>

                <div class="mb-5 flex items-center">
                    <label for="tituloTesis3" class="block text-sm font-medium text-gray-700 w-1/3 mr-4">Título de Tesis: </label>
                    <input type="text" id="tituloTesis3" placeholder="Título completo de la tesis..." class="input-field px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition duration-300">
                </div>

                <div class="mb-5 flex items-center">
                    <label for="grado3" class="block text-sm font-medium text-gray-700 w-1/3 mr-4">Grado: </label>
                    <div class="w-2/3">
                        <select id="grado3" class="input-field w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition duration-300">
                            <option value="" selected disabled>Selecciona un Grado</option>
                            <option value="licenciatura">Licenciatura</option>
                            <option value="maestria">Maestría</option>
                            <option value="doctorado">Doctorado</option>
                        </select>
                    </div>
                </div>

                <div class="mb-5 flex items-center">
                    <label for="institucion3" class="block text-sm font-medium text-gray-700 w-1/3 mr-4">Institución: </label>
                    <input type="text" id="institucion3" placeholder="Nombre de la institución..." class="input-field px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition duration-300">
                </div>

                <div class="mb-6 flex items-center">
                    <label for="estatus3" class="block text-sm font-medium text-gray-700 w-1/3 mr-4">Estatus: </label>
                    <input type="text" id="estatus3" placeholder="En curso, completada, pendiente..." class="input-field px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition duration-300">
                </div>

                <div class="flex justify-start pt-4">
                    <button type="submit" class="
                        bg-gray-100 text-gray-700 text-sm font-normal 
                        py-2 px-4 
                        border border-gray-400 rounded-lg shadow-sm 
                        hover:bg-gray-200 transition duration-150
                    ">
                        Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
{% endmacro %}

