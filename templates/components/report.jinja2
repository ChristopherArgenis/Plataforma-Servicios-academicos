{% macro contentInfoGeneral() %}
    <div class="alert alert-info shadow-sm" role="alert">
        <i class="bi bi-info-circle-fill me-2"></i>
        Este es el contenido de la sección de Información General. Puedes agregar aquí los detalles que necesites mostrar.
    </div>
{% endmacro %}

{% macro accordion() %}
    <div class="container mt-4">
        <div class="accordion shadow-sm rounded" id="miAcordeon1">
            <div class="accordion-item border-0 rounded overflow-hidden">
                <h2 class="accordion-header" id="headingGeneral1">
                <button class="accordion-button fw-bold text-primary bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapseGeneral1" aria-expanded="true" aria-controls="collapseGeneral1">
                    <i class="bi bi-person-lines-fill me-2"></i> Información General
                </button>
                </h2>
                <div id="collapseGeneral1" class="accordion-collapse collapse show" aria-labelledby="headingGeneral1" data-bs-parent="#miAcordeon1">
                    <div class="accordion-body bg-white">
                        {{ contentInfoGeneral() }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endmacro %}

{% macro modal_pdf() %}
    <!-- Botón para abrir modal PDF -->
     <div class="d-flex justify-content-center my-5">
        <button type="button" class="btn btn-primary btn-lg shadow" data-bs-toggle="modal" data-bs-target="#pdfModal">
            <i class="bi bi-file-earmark-pdf me-2"></i> Ver reporte
        </button>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="pdfModal" tabindex="-1" aria-labelledby="pdfModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
          <div class="modal-header bg-primary text-white">
            <h5 class="modal-title" id="pdfModalLabel">
                <i class="bi bi-file-earmark-text me-2"></i> Reporte generado
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
          </div>
          <div class="modal-body p-0 bg-light">
            <div class="p-2 d-flex justify-content-end bg-white border-bottom">
                <a href="{{ url_for('static', filename='docs/ejemplo.pdf') }}" target="_blank" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-box-arrow-up-right me-1"></i> Abrir en nueva pestaña
                </a>
            </div>
            <iframe src="{{ url_for('static', filename='docs/ejemplo.pdf') }}" width="100%" height="600px" style="border: none"></iframe>
          </div>
        </div>
      </div>
    </div>
{% endmacro %}

{% macro steps_report() %}
<!-- Barra de pasos -->
  <div class="step-bar mb-5 mx-auto" style="max-width: 1000px;">
    <div class="progress-line">
      <div id="progress-fill" class="progress-line-fill"></div>
    </div>
    <div class="step active" id="step-1">
      <div class="circle shadow-sm"><i class="bi bi-pencil-square"></i></div>
      <div class="label fw-bold">Libros</div>
    </div>
    <div class="step" id="step-2">
      <div class="circle shadow-sm"><i class="bi bi-journal-text"></i></div>
      <div class="label fw-bold">Artículos</div>
    </div>
    <div class="step" id="step-3">
      <div class="circle shadow-sm"><i class="bi bi-book"></i></div>
      <div class="label fw-bold">Cursos</div>
    </div>
    <div class="step" id="step-4">
      <div class="circle shadow-sm"><i class="bi bi-people-fill"></i></div>
      <div class="label fw-bold">Comités</div>
    </div>
    <div class="step" id="step-5">
      <div class="circle shadow-sm"><i class="bi bi-megaphone"></i></div>
      <div class="label fw-bold">Difusión</div>
    </div>
    <div class="step" id="step-6">
      <div class="circle shadow-sm"><i class="bi bi-check-lg"></i></div>
      <div class="label fw-bold">Finalizar</div>
    </div>
  </div>
{% endmacro %}

{% macro inputs_report() %}
  <!-- Contenido de pasos -->
  <div class="steps-content mx-auto" style="max-width: 1000px;">
    <div id="paso1">
        {{ book_science() }} 
    </div>

    <div id="paso2" style="display: none;">
        {{ Tesis_Teaching() }}
    </div>

    <div id="paso3" style="display: none;">
        {{ courses() }}
    </div>

    <div id="paso4" style="display: none;">
        {{ comites_jurado() }}
    </div>

    <div id="paso5" style="display: none;">
        {{ difusion() }}
    </div>

    <div id="paso6" style="display: none;">
      <div class="card shadow border-0 rounded-4">
        <div class="card-body text-center p-5">
            <h3 class="text-success mb-4"><i class="bi bi-check-circle-fill display-4"></i></h3>
            <h4 class="mb-3">¡Proceso Completado!</h4>
            <p class="text-muted mb-4">Has capturado toda la información necesaria. Ahora puedes generar y visualizar tu reporte.</p>
            {{ modal_pdf() }}
        </div>
      </div>
    </div>
  </div>
{% endmacro %}

{% macro button_report() %}
  <!-- Botones -->
  <div class="d-flex justify-content-center gap-3 mt-5 mx-auto" style="max-width: 1000px;">
    <button id="btnAnterior" class="btn btn-outline-secondary px-4 rounded-pill shadow-sm" disabled>
        <i class="bi bi-arrow-left me-2"></i> Anterior
    </button>
    <button id="btnSiguiente" class="btn btn-primary px-4 rounded-pill shadow-sm">
        Siguiente <i class="bi bi-arrow-right ms-2"></i>
    </button>
  </div>
{% endmacro %}

