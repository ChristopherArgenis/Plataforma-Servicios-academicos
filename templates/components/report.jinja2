            </div>

            <!-- Campos Comunes -->
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="form-floating">
                        <select class="form-select" name="nivelAcademico">
                            <option value="" selected disabled>Seleccionar...</option>
