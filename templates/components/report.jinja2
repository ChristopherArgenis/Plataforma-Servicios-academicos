                    <label class="btn btn-outline-primary" for="tipoComite">
                        <i class="bi bi-people me-2"></i>Comité
                    </label>
                    
                    <input type="radio" class="btn-check" name="tipoParticipacion" id="tipoJurado" value="jurado">
