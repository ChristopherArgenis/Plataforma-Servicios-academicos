{% macro body_difusion() %}
    <div class="p-4 bg-white">
        <form id="formularioDifusion">
            <!-- SECCIÓN 1: CONGRESOS -->
            <h5 class="mb-3 text-secondary border-bottom pb-2">Congresos</h5>
            <div id="congresoContainer">
                <div class="dynamic-congreso-row border rounded p-3 mb-3 bg-light position-relative">
                    <button type="button" class="btn-close position-absolute top-0 end-0 m-2 delete-row-btn" aria-label="Eliminar" style="display: none;"></button>
                    
                    <div class="row g-3">
                         <div class="col-md-12">
                            <label class="form-label fw-bold small">Título del Trabajo/Plática</label>
                            <input type="text" class="form-control" name="tituloTrabajo[]" placeholder="Título">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Autores</label>
                            <input type="text" class="form-control" name="autores[]" placeholder="Autores">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Nombre del Evento</label>
                            <input type="text" class="form-control" name="nombreEvento[]" placeholder="Evento">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Lugar</label>
                            <input type="text" class="form-control" name="lugar[]" placeholder="Lugar">
                        </div>

                        <div class="col-md-3">
                             <label class="form-label fw-bold small">Fecha Inicio</label>
                             <input type="date" class="form-control" name="fechaInicio[]">
                        </div>
                        <div class="col-md-3">
                             <label class="form-label fw-bold small">Fecha Fin</label>
                             <input type="date" class="form-control" name="fechaFin[]">
                        </div>

                        <div class="col-md-6">
                             <label class="form-label fw-bold small">Ponente</label>
                             <input type="text" class="form-control" name="ponente[]" placeholder="Ponente">
                        </div>

                        <div class="col-md-12">
                             <label class="form-label fw-bold small">Estudiantes (Lista separada por comas)</label>
                             <input type="text" class="form-control" name="estudiantes[]" placeholder="Estudiantes involucrados">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Modalidad</label>
                            <select class="form-select" name="modalidad[]">
                                <option value="presencial">Presencial</option>
                                <option value="linea">En línea</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Alcance</label>
                            <select class="form-select" name="alcance[]">
                                <option value="internacional">Internacional</option>
                                <option value="nacional">Nacional</option>
                            </select>
                        </div>
                    </div>
