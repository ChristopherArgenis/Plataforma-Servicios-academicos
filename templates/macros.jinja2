{% macro prueba() %}
    <h6>Hola Estoy aqui</h6>
{% endmacro %}

{% macro columns_Articles() %}
    <tr>
        <th scope="col">T&iacutetulo</th>
        <th scope="col">A&ntildeo</th>
    </tr>
{% endmacro %}

{% macro table_articles(df) %}
    <table class="table table-striped table-hover">
        <thead class="table-light">
            {{ columns_Articles() }}
            <tbody>
                {% for row in df.itertuples(index=False) %}
                    <tr>
                        {% for value in row %}
                            <td>{{ value }}</td>
                        {% endfor %}
                    </tr>
                {% endfor %}
            </tbody>
        </thead>
    </table>
{% endmacro %}