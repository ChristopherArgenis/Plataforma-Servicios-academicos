{% macro prueba() %}
    <h6>Hola Estoy aqui</h6>
{% endmacro %}

{% macro columns_Articles() %}
    <tr>
        <th scope="col">T&iacutetulo</th>
        <th scope="col">A&ntildeo</th>
    </tr>
{% endmacro %}

{% macro table_articles(df) %}
    <table class="table table-striped table-hover">
        <thead class="table-light">
            {{ columns_Articles() }}
            <tbody>
                {% for row in df.itertuples(index=False) %}
                    <tr>
                        {% for value in row %}
                            <td>{{ value }}</td>
                        {% endfor %}
                    </tr>
                {% endfor %}
            </tbody>
        </thead>
    </table>
{% endmacro %}

{% macro search() %}
    <nav class="navbar bg-body-tertiary">
        <div class="container-fluid">
            <form method="POST" class="d-flex" role="search">
                <input class="form-control me-2" type="search" placeholder="Título" aria-label="Search" name="titulo">
                <button class="btn btn-outline-success" type="submit">Buscar</button>
            </form>
        </div>
        <form method="GET" action={{ url_for('panel.panel_view') }}>
            <button class="btn btn-outline-secondary" type="submit">Reiniciar</button>
        </form>
        <ul></ul>
    </nav>
{% endmacro %}