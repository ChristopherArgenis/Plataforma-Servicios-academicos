# Copia este archivo como ".env" y llena los valores. El archivo .env NO se sube a GitHub.

# Clave para firmar las sesiones. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Clave de SerpAPI (https://serpapi.com/manage-api-key)
SERPAPI_KEY=

# Opcionales
# FLASK_DEBUG=1            # solo en tu computadora, nunca en el servidor
# HOST=0.0.0.0
# PORT=3000
# SESSION_COOKIE_SECURE=1  # solo si la app se sirve con HTTPS
