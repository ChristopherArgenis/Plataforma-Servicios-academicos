# Copia este archivo como ".env" y llena los valores.

# Clave para firmar las sesiones. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Clave de SerpAPI (https://serpapi.com/manage-api-key).
SERPAPI_KEY=

# Origen de los datos de Google Scholar:
#   serpapi -> consulta real (requiere SERPAPI_KEY)
#   demo    -> datos de ejemplo, sin internet ni costo
SCHOLAR_PROVIDER=serpapi

# Base de datos. Si se deja vacío se usa SQLite en instance/plataforma.db
# Ejemplos para un servidor propio:
#   mysql+pymysql://usuario:clave@localhost/plataforma
#   postgresql+psycopg://usuario:clave@localhost/plataforma
DATABASE_URL=

# Pon 1 solo si la app se sirve con HTTPS (cookies seguras).
SESSION_COOKIE_SECURE=0
